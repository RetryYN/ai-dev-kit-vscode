#!/bin/bash
set -euo pipefail

# Thin wrapper that forwards CLI flags, including selection hints,
# interactive selection, and output-format flags, to the Python entrypoint.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=cli/lib/helix-common.sh
source "$SCRIPT_DIR/lib/helix-common.sh"

exec env PYTHONPATH="$HELIX_HOME${PYTHONPATH:+:$PYTHONPATH}" python3 -m cli.lib.test_design_scaffold "$@"
