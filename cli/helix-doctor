#!/bin/bash
set -euo pipefail
# helix-doctor: 環境チェック
# Usage: helix doctor [check_recovery_plan_freshness|check_g7_subcheck|check_vg_overview|check_requirement_drift|check_l7_worklist|check_coding_rule_lint|check_import_cycle|check_plan_dependency_gate|check_fr_uses] [--gate] [--fix] [--cleanup-stale-locks] [--max-age-days N] [--focus L6|L7] [--check-stale] [--strict-full-flow] [--json] [--summary]

source "$(cd "$(dirname "$0")" && pwd)/lib/helix-common.sh"
SELF_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SELF_PATH")" && pwd)"
USAGE_TEXT="使い方: helix doctor [check_recovery_plan_freshness|check_g7_subcheck|check_vg_overview|check_requirement_drift|check_l7_worklist|check_coding_rule_lint|check_import_cycle|check_plan_dependency_gate|check_fr_uses] [--gate] [--fix] [--cleanup-stale-locks] [--max-age-days N] [--focus L6|L7] [--check-stale] [--strict-full-flow] [--strict-vmodel-pair-freeze] [--vmodel-pair-freeze-active-only] [--vmodel-pair-freeze-since-days N] [--suggest-revisions] [--apply-stale-revisions] [--apply-patches] [--rollback-stale-revisions] [--apply] [--json] [--summary]"
PROJECT_NAME="$(basename "$PROJECT_ROOT")"
FIX=false
CLEANUP_STALE_LOCKS=false
SUBCOMMAND=""
MAX_AGE_DAYS=30
REQUIREMENT_DRIFT_FOCUS=L6
REQUIREMENT_DRIFT_CHECK_STALE=false
VG_OVERVIEW_STRICT_FULL_FLOW=false
JSON_OUTPUT=false
SUMMARY_OUTPUT=false
GATE_MODE=false
STRICT_VMODEL_PAIR_FREEZE=false
VMODEL_PAIR_FREEZE_ACTIVE_ONLY=false
VMODEL_PAIR_FREEZE_SINCE_DAYS=""
SUGGEST_REVISIONS=false
APPLY_STALE_REVISIONS=false
APPLY_PATCHES=false
ROLLBACK_STALE_REVISIONS=false
APPLY_WRITES=false
FORWARDED_ARGS=()

show_usage() {
  printf '%s\n' "$USAGE_TEXT"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    check_recovery_plan_freshness|check_g7_subcheck|check_vg_overview|check_requirement_drift|check_l7_worklist|check_coding_rule_lint|check_import_cycle|check_plan_dependency_gate|check_fr_uses)
      if [[ -n "$SUBCOMMAND" ]]; then
        echo "エラー: サブコマンドは 1 つだけ指定できます: $1" >&2
        show_usage >&2
        exit 2
      fi
      SUBCOMMAND="$1"
      FORWARDED_ARGS+=("$1")
      ;;
    --fix)
      FIX=true
      FORWARDED_ARGS+=("$1")
      ;;
    --cleanup-stale-locks)
      CLEANUP_STALE_LOCKS=true
      FORWARDED_ARGS+=("$1")
      ;;
    --max-age-days)
      shift
      if [[ $# -eq 0 || ! "$1" =~ ^[0-9]+$ ]]; then
        echo "エラー: --max-age-days には 0 以上の整数が必要です" >&2
        exit 2
      fi
      MAX_AGE_DAYS="$1"
      FORWARDED_ARGS+=("--max-age-days" "$1")
      ;;
    --focus)
      shift
      if [[ $# -eq 0 || ! "$1" =~ ^L[67]$ ]]; then
        echo "エラー: --focus には L6 または L7 が必要です" >&2
        exit 2
      fi
      REQUIREMENT_DRIFT_FOCUS="$1"
      FORWARDED_ARGS+=("--focus" "$1")
      ;;
    --check-stale)
      REQUIREMENT_DRIFT_CHECK_STALE=true
      FORWARDED_ARGS+=("$1")
      ;;
    --strict-full-flow)
      VG_OVERVIEW_STRICT_FULL_FLOW=true
      FORWARDED_ARGS+=("$1")
      ;;
    --json)
      JSON_OUTPUT=true
      ;;
    --summary)
      SUMMARY_OUTPUT=true
      ;;
    --gate)
      GATE_MODE=true
      FORWARDED_ARGS+=("$1")
      ;;
    --strict-vmodel-pair-freeze)
      STRICT_VMODEL_PAIR_FREEZE=true
      FORWARDED_ARGS+=("$1")
      ;;
    --vmodel-pair-freeze-active-only)
      VMODEL_PAIR_FREEZE_ACTIVE_ONLY=true
      FORWARDED_ARGS+=("$1")
      ;;
    --vmodel-pair-freeze-since-days)
      shift
      if [[ $# -eq 0 || ! "$1" =~ ^[0-9]+$ ]]; then
        echo "エラー: --vmodel-pair-freeze-since-days には 0 以上の整数が必要です" >&2
        exit 2
      fi
      VMODEL_PAIR_FREEZE_SINCE_DAYS="$1"
      FORWARDED_ARGS+=("--vmodel-pair-freeze-since-days" "$1")
      ;;
    --suggest-revisions)
      SUGGEST_REVISIONS=true
      FORWARDED_ARGS+=("$1")
      ;;
    --apply-stale-revisions)
      APPLY_STALE_REVISIONS=true
      FORWARDED_ARGS+=("$1")
      ;;
    --apply-patches)
      APPLY_PATCHES=true
      FORWARDED_ARGS+=("$1")
      ;;
    --rollback-stale-revisions)
      ROLLBACK_STALE_REVISIONS=true
      FORWARDED_ARGS+=("$1")
      ;;
    --apply)
      APPLY_WRITES=true
      FORWARDED_ARGS+=("$1")
      ;;
    --help|-h)
      show_usage
      echo ""
      echo "環境と .helix/ の整合性をチェックします。"
      echo "--cleanup-stale-locks を付けると dead PID の lockfile を削除します。"
      echo "check_recovery_plan_freshness は docs/plans/PLAN-*-recovery-*.md を走査し、鮮度警告を表示します。"
      echo "check_g7_subcheck は L7 UT anchor/test pass を advisory 集計します。"
      echo "check_vg_overview は registry/trace/G7 を advisory 集計します。--strict-full-flow 指定時は approved_deferred execution gate を full-flow 未完として扱います。"
      echo "check_l7_worklist は functional-registry 由来の L7 worklist summary を advisory 表示します。"
      echo "check_requirement_drift は L1/L3 FR から L4-L6 design までを advisory 集計します。--focus L7 指定時のみ code/test も見ます。--check-stale 指定時のみ mtime stale 候補も見ます。"
      echo "check_coding_rule_lint は bash -n / py_compile / ruff / shellcheck を advisory または changed-files gate で集計します。"
      echo "check_import_cycle は cli/lib の Python import と cli/ の Bash source 依存の循環を advisory または changed-files gate で集計します。"
      echo "check_plan_dependency_gate は PLAN dependency warning を baseline + changed-files gate で集計します。"
      echo "check_fr_uses は functional-registry の uses 実在/逆参照 warning を advisory または changed-files gate で集計します。"
      echo "--gate を付けると VG-overview pre-push 条件を fail-close 評価します。"
      echo "--strict-vmodel-pair-freeze を付けると critical missing pair docs がある場合に exit 1 で失敗します。"
      echo "--vmodel-pair-freeze-active-only を付けると status=draft|in_progress の pair PLAN のみ集計します。"
      echo "--vmodel-pair-freeze-since-days N を付けると N 日以内に revised/created された pair PLAN のみ集計します。"
      echo "--suggest-revisions を付けると stale PLAN に対する revised 更新候補 hint を表示します。"
      echo "--apply-stale-revisions を付けると stale PLAN revised 更新の dry-run または apply を実行します。"
      echo "--apply-patches を付けると stale PLAN patch の dry-run または git apply を実行します。"
      echo "--rollback-stale-revisions を付けると最新 audit record に基づく rollback の dry-run または apply を実行します。"
      echo "--apply を併用すると --apply-stale-revisions / --apply-patches / --rollback-stale-revisions の結果を実 file に反映します。"
      echo "--json を付けると text 出力を抑止し、構造化 JSON のみを stdout に出力します。"
      echo "--summary を付けると text 出力を parse し、section 集計 JSON のみを stdout に出力します。"
      exit 0
      ;;
    *)
      echo "エラー: 不明なオプション: $1" >&2
      show_usage >&2
      exit 2
      ;;
  esac
  shift
done

if [[ "$JSON_OUTPUT" == true && "$SUMMARY_OUTPUT" == true ]]; then
  echo "エラー: --json と --summary は同時に使用できません" >&2
  exit 2
fi

render_doctor_json() {
  local doctor_output="$1"
  python3 - <<'PY' "$doctor_output"
import json
import re
import sys
from datetime import datetime

text = sys.argv[1]
match = re.search(r"結果:\s+(\d+)\s+pass,\s+(\d+)\s+fail,\s+(\d+)\s+warn", text)
if not match:
    raise SystemExit(1)

pass_count, fail_count, warn_count = (int(value) for value in match.groups())
advisories = []
category = ""
current = None

for line in text.splitlines():
    stripped = line.strip()
    if line.startswith("[") and line.endswith("]"):
        category = line[1:-1]
        current = None
        continue

    advisory_match = re.match(r"^\s*(△|✗|⚠|WARN:)\s*(.+)$", line)
    if advisory_match:
        marker, name = advisory_match.groups()
        current = {
            "category": category or "doctor",
            "name": name.replace("（推奨）", "").strip(),
            "status": "fail" if marker == "✗" else "warning",
            "detail": "",
        }
        advisories.append(current)
        continue

    if current is not None and (line.startswith("    ") or line.startswith("      ")):
        detail = stripped
        if detail:
            current["detail"] = f"{current['detail']} {detail}".strip() if current["detail"] else detail
        continue

    current = None

for advisory in advisories:
    if not advisory["detail"]:
      advisory["detail"] = advisory["name"]

payload = {
    "timestamp": datetime.now().astimezone().isoformat(timespec="seconds"),
    "pass": pass_count,
    "fail": fail_count,
    "warn": warn_count,
    "advisories": advisories,
    "summary": f"{pass_count} pass, {fail_count} fail, {warn_count} warn",
}
print(json.dumps(payload, ensure_ascii=False))
PY
}

render_doctor_summary() {
  local doctor_output="$1"
  printf '%s' "$doctor_output" | python3 "$(cd "$(dirname "$0")" && pwd)/lib/doctor_summary.py"
}

subcommand_supports_json() {
  case "${1:-}" in
    check_g7_subcheck|check_vg_overview|check_requirement_drift|check_l7_worklist|check_coding_rule_lint|check_import_cycle|check_plan_dependency_gate|check_fr_uses)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

run_python_report_helper() {
  local module_name="$1"
  shift
  HELIX_SCRIPT_LIB="$SCRIPT_DIR/lib" HELIX_REPORT_MODULE="$module_name" python3 - "$@" <<'PY'
import importlib
import json
import os
import sys

sys.path.insert(0, os.environ["HELIX_SCRIPT_LIB"])

module = importlib.import_module(os.environ["HELIX_REPORT_MODULE"])
module_name = os.environ["HELIX_REPORT_MODULE"]
if module_name == "g7_subcheck":
    report = module.collect_g7_subcheck()
elif module_name == "vg_overview":
    report = module.collect_vg_overview(
        strict_full_flow=os.environ.get("HELIX_VG_OVERVIEW_STRICT_FULL_FLOW") == "1"
    )
elif module_name == "requirement_drift":
    report = module.collect_requirement_drift(
        focus=os.environ.get("HELIX_REQUIREMENT_DRIFT_FOCUS", "L6"),
        check_stale=os.environ.get("HELIX_REQUIREMENT_DRIFT_CHECK_STALE") == "1",
    )
elif module_name == "l7_worklist":
    report = module.collect_l7_worklist(
        "cli/config/functional-registry.yaml",
        "docs/v2/L7-test-design/g7-test-anchor-map.yaml",
        ".",
    )
elif module_name == "coding_rule_lint":
    report = module.evaluate_coding_rule_lint(
        repo_root=".",
        registry_path="cli/config/coding-rule-registry.yaml",
        baseline_path="cli/config/coding-rule-registry-baseline.json",
        gate=os.environ.get("HELIX_CODING_RULE_LINT_GATE") == "1",
    )
elif module_name == "dependency_cycle_checks":
    report = module.check_dependency_cycle_gate(
        repo_root=".",
        baseline_path="cli/config/import-cycle-baseline.json",
        gate=os.environ.get("HELIX_IMPORT_CYCLE_GATE") == "1",
    )
elif module_name == "plan_dependency_gate":
    report = module.check_plan_dependency_gate(
        repo_root=".",
        baseline_path="cli/config/plan-dependency-baseline.json",
        gate=os.environ.get("HELIX_PLAN_DEPENDENCY_GATE") == "1",
    )
elif module_name == "fr_uses_checks":
    report = module.check_fr_uses(
        repo_root=".",
        registry_path="cli/config/functional-registry.yaml",
        gate=os.environ.get("HELIX_FR_USES_GATE") == "1",
    )
else:
    raise SystemExit(f"unsupported report module: {module_name}")
print(json.dumps(report, ensure_ascii=False, sort_keys=True))
PY
}

if [[ "$JSON_OUTPUT" == true ]]; then
  if [[ -n "$SUBCOMMAND" ]]; then
    if ! subcommand_supports_json "$SUBCOMMAND"; then
      echo "エラー: --json はデフォルト doctor 出力でのみ使用できます" >&2
      exit 2
    fi
  else
    tmp_stderr="$(mktemp)"
    set +e
    doctor_output="$("$SELF_PATH" "${FORWARDED_ARGS[@]}" 2>"$tmp_stderr")"
    doctor_rc=$?
    set -e
    doctor_stderr="$(cat "$tmp_stderr")"
    rm -f "$tmp_stderr"

    if [[ $doctor_rc -gt 1 ]]; then
      [[ -n "$doctor_stderr" ]] && printf '%s\n' "$doctor_stderr" >&2
      exit "$doctor_rc"
    fi

    if ! json_output="$(render_doctor_json "$doctor_output")"; then
      [[ -n "$doctor_stderr" ]] && printf '%s\n' "$doctor_stderr" >&2
      echo "エラー: doctor text 出力の JSON 変換に失敗しました" >&2
      exit 1
    fi

    printf '%s\n' "$json_output"
    exit "$doctor_rc"
  fi
fi

if [[ "$SUMMARY_OUTPUT" == true ]]; then
  if [[ -n "$SUBCOMMAND" ]]; then
    echo "エラー: --summary はデフォルト doctor 出力でのみ使用できます" >&2
    exit 2
  fi

  tmp_stderr="$(mktemp)"
  set +e
  doctor_output="$("$SELF_PATH" "${FORWARDED_ARGS[@]}" 2>"$tmp_stderr")"
  doctor_rc=$?
  set -e
  doctor_stderr="$(cat "$tmp_stderr")"
  rm -f "$tmp_stderr"

  if [[ $doctor_rc -gt 1 ]]; then
    [[ -n "$doctor_stderr" ]] && printf '%s\n' "$doctor_stderr" >&2
    exit "$doctor_rc"
  fi

  if ! summary_output="$(render_doctor_summary "$doctor_output")"; then
    [[ -n "$doctor_stderr" ]] && printf '%s\n' "$doctor_stderr" >&2
    echo "エラー: doctor text 出力の summary 変換に失敗しました" >&2
    exit 1
  fi

  printf '%s\n' "$summary_output"
  exit "$doctor_rc"
fi

if [[ "$SUBCOMMAND" == "check_g7_subcheck" ]]; then
  report_json="$(run_python_report_helper g7_subcheck 2>&1)"
  if [[ "$JSON_OUTPUT" == true ]]; then
    printf '%s\n' "$report_json"
  else
    HELIX_SCRIPT_LIB="$SCRIPT_DIR/lib" python3 - <<'PY' "$report_json"
import json
import sys

payload = json.loads(sys.argv[1])
print("G7 subcheck (advisory)")
print(f"anchor_mechanism: {payload['anchor_mechanism']}")
print(f"anchor_map: {payload['anchor_map']}")
print(f"ut_total: {payload['ut_total']}")
print(f"legacy_inline_anchors: {payload['legacy_inline_anchors']['count']}")
print(f"anchored: {payload['anchored']['count']}")
print(f"exec_pass: {payload['exec_pass']['count']}")
print(f"missing: {payload['missing']['count']}")
print(f"unanchored_but_exists: {payload['unanchored_but_exists']['count']}")
if payload["missing"]["ids"]:
    print("missing_ids: " + ", ".join(payload["missing"]["ids"]))
if payload["unanchored_but_exists"]["ids"]:
    print("unanchored_ids: " + ", ".join(payload["unanchored_but_exists"]["ids"]))
PY
  fi
  exit 0
fi

if [[ "$SUBCOMMAND" == "check_vg_overview" ]]; then
  strict_full_flow_env=0
  if [[ "$VG_OVERVIEW_STRICT_FULL_FLOW" == true ]]; then
    strict_full_flow_env=1
  fi
  report_json="$(HELIX_VG_OVERVIEW_STRICT_FULL_FLOW="$strict_full_flow_env" run_python_report_helper vg_overview 2>&1)"
  if [[ "$JSON_OUTPUT" == true ]]; then
    printf '%s\n' "$report_json"
  else
    HELIX_SCRIPT_LIB="$SCRIPT_DIR/lib" python3 - <<'PY' "$report_json"
import json
import sys

payload = json.loads(sys.argv[1])
vg = payload["vg_overview"]
print("VG-overview (advisory)")
print(f"overall_clean: {str(vg['overall_clean']).lower()}")
full = vg["full_flow_execution"]
print(
    "full_flow_execution: "
    f"enforced={str(full['enforced']).lower()} "
    f"clean={str(full['clean']).lower()} "
    f"deferred={full['deferred_count']}"
)
for name, item in vg["required_clean"].items():
    print(f"{name}: clean={str(item['clean']).lower()} findings={item['finding_count']}")
for pair_name, item in vg["pair_status"].items():
    print(
        f"{pair_name}: status={item['status']} clean={str(item['clean']).lower()} reason={item['reason']}"
    )
PY
  fi
  # --gate: VG-overview pre-push 条件を fail-close 評価する (help 記載の契約を実体化)。
  # vg_overview.overall_clean のみに依存し、.helix/ project-state には依存しない
  # ため、CI fresh checkout の Required check として安全に使える。
  if [[ "$GATE_MODE" == true ]]; then
    gate_verdict="$(HELIX_SCRIPT_LIB="$SCRIPT_DIR/lib" python3 - <<'PY' "$report_json"
import json
import sys

try:
    payload = json.loads(sys.argv[1])
    print("clean" if payload["vg_overview"]["overall_clean"] else "dirty")
except Exception:
    print("error")
PY
)"
    if [[ "$gate_verdict" != "clean" ]]; then
      exit 1
    fi
  fi
  exit 0
fi

if [[ "$SUBCOMMAND" == "check_requirement_drift" ]]; then
  stale_env=0
  if [[ "$REQUIREMENT_DRIFT_CHECK_STALE" == true ]]; then
    stale_env=1
  fi
  report_json="$(HELIX_REQUIREMENT_DRIFT_FOCUS="$REQUIREMENT_DRIFT_FOCUS" HELIX_REQUIREMENT_DRIFT_CHECK_STALE="$stale_env" run_python_report_helper requirement_drift 2>&1)"
  if [[ "$JSON_OUTPUT" == true ]]; then
    printf '%s\n' "$report_json"
  else
    HELIX_SCRIPT_LIB="$SCRIPT_DIR/lib" python3 - <<'PY' "$report_json"
import json
import sys

payload = json.loads(sys.argv[1])
print("requirement_drift (advisory)")
print(f"clean: {str(payload['clean']).lower()}")
print(f"focus: {payload.get('focus', 'L6')}")
print(f"stale_check_enabled: {str(payload.get('stale_check_enabled', False)).lower()}")
print(f"scope: {payload['scope']}")
summary = payload["summary"]
print(
    "summary: "
    f"requirements={summary['requirements']} "
    f"design_links={summary['design_links']} "
    f"code_links={summary['code_links']} "
    f"test_links={summary['test_links']}"
)
for name, items in payload["findings"].items():
    print(f"{name}: {len(items)}")
if payload.get("advisory"):
    print(f"advisory: {payload['advisory']}")
if payload.get("parse_warnings"):
    print(f"parse_warnings: {len(payload['parse_warnings'])}")
PY
  fi
  exit 0
fi

if [[ "$SUBCOMMAND" == "check_l7_worklist" ]]; then
  report_json="$(run_python_report_helper l7_worklist 2>&1)"
  if [[ "$JSON_OUTPUT" == true ]]; then
    printf '%s\n' "$report_json"
  else
    HELIX_SCRIPT_LIB="$SCRIPT_DIR/lib" python3 - <<'PY' "$report_json"
import json
import sys

payload = json.loads(sys.argv[1])
summary = payload["summary"]
print("L7 worklist (advisory)")
print(
    "summary: "
    f"total={summary['total']} "
    f"anchored={summary['anchored']} "
    f"waived={summary['waived']} "
    f"missing={summary['missing']}"
)
for item in payload["worklist"]:
    detail = f"{item['fn']} -> {item.get('ut') or '<missing>'} [{item['status']}]"
    if item.get("code_path"):
        detail += f" {item['code_path']}"
    print(detail)
PY
  fi
  exit 0
fi

if [[ "$SUBCOMMAND" == "check_coding_rule_lint" ]]; then
  coding_rule_gate_env=0
  if [[ "$GATE_MODE" == true ]]; then
    coding_rule_gate_env=1
  fi
  report_json="$(HELIX_CODING_RULE_LINT_GATE="$coding_rule_gate_env" run_python_report_helper coding_rule_lint 2>&1)"
  if [[ "$JSON_OUTPUT" == true ]]; then
    printf '%s\n' "$report_json"
  else
    HELIX_SCRIPT_LIB="$SCRIPT_DIR/lib" python3 - <<'PY' "$report_json"
import json
import sys

payload = json.loads(sys.argv[1])
print("coding_rule_lint (gate)" if payload["mode"] == "gate" else "coding_rule_lint (advisory)")
print(f"clean: {str(payload['clean']).lower()}")
print(f"source_status: {payload['source_status']}")
print(f"findings: {payload['finding_count']}")
print(f"new_findings={payload['new_finding_count']}")
if payload.get("skipped_reason"):
    print(f"skipped_reason: {payload['skipped_reason']}")
if payload["new_findings"]:
    preview = payload["new_findings"][0]
    print(
        "preview: "
        f"{preview['tool']} {preview['file']}:{preview['line']} {preview['message']}"
    )
PY
  fi
  exit "$(python3 - <<'PY' "$report_json"
import json
import sys
print(json.loads(sys.argv[1])["exit_code"])
PY
)"
fi

if [[ "$SUBCOMMAND" == "check_import_cycle" ]]; then
  import_cycle_gate_env=0
  if [[ "$GATE_MODE" == true ]]; then
    import_cycle_gate_env=1
  fi
  report_json="$(HELIX_IMPORT_CYCLE_GATE="$import_cycle_gate_env" run_python_report_helper dependency_cycle_checks 2>&1)"
  if [[ "$JSON_OUTPUT" == true ]]; then
    printf '%s\n' "$report_json"
  else
    HELIX_SCRIPT_LIB="$SCRIPT_DIR/lib" python3 - <<'PY' "$report_json"
import json
import sys

payload = json.loads(sys.argv[1])
print("import_cycle (gate)" if payload["mode"] == "gate" else "import_cycle (advisory)")
print(f"clean: {str(payload['clean']).lower()}")
print(f"source_status: {payload['source_status']}")
print(f"findings: {payload['finding_count']}")
print(f"new_findings={payload['new_finding_count']}")
if payload.get("skipped_reason"):
    print(f"skipped_reason: {payload['skipped_reason']}")
if payload["new_findings"]:
    preview = payload["new_findings"][0]
    print(f"preview: {preview['language']} {' -> '.join(preview['cycle'])}")
PY
  fi
  exit "$(python3 - <<'PY' "$report_json"
import json
import sys
print(json.loads(sys.argv[1])["exit_code"])
PY
)"
