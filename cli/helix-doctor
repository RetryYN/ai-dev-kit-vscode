#!/bin/bash
set -euo pipefail
# helix-doctor: 環境チェック
# Usage: helix doctor [check_recovery_plan_freshness] [--fix] [--cleanup-stale-locks] [--max-age-days N] [--json]

source "$(cd "$(dirname "$0")" && pwd)/lib/helix-common.sh"
SELF_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
USAGE_TEXT="使い方: helix doctor [check_recovery_plan_freshness] [--fix] [--cleanup-stale-locks] [--max-age-days N] [--strict-vmodel-pair-freeze] [--vmodel-pair-freeze-active-only] [--json]"
PROJECT_NAME="$(basename "$PROJECT_ROOT")"
FIX=false
CLEANUP_STALE_LOCKS=false
SUBCOMMAND=""
MAX_AGE_DAYS=30
JSON_OUTPUT=false
STRICT_VMODEL_PAIR_FREEZE=false
VMODEL_PAIR_FREEZE_ACTIVE_ONLY=false
FORWARDED_ARGS=()

show_usage() {
  printf '%s\n' "$USAGE_TEXT"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    check_recovery_plan_freshness)
      if [[ -n "$SUBCOMMAND" ]]; then
        echo "エラー: サブコマンドは 1 つだけ指定できます: $1" >&2
        show_usage >&2
        exit 2
      fi
      SUBCOMMAND="$1"
      FORWARDED_ARGS+=("$1")
      ;;
    --fix)
      FIX=true
      FORWARDED_ARGS+=("$1")
      ;;
    --cleanup-stale-locks)
      CLEANUP_STALE_LOCKS=true
      FORWARDED_ARGS+=("$1")
      ;;
    --max-age-days)
      shift
      if [[ $# -eq 0 || ! "$1" =~ ^[0-9]+$ ]]; then
        echo "エラー: --max-age-days には 0 以上の整数が必要です" >&2
        exit 2
      fi
      MAX_AGE_DAYS="$1"
      FORWARDED_ARGS+=("--max-age-days" "$1")
      ;;
    --json)
      JSON_OUTPUT=true
      ;;
    --strict-vmodel-pair-freeze)
      STRICT_VMODEL_PAIR_FREEZE=true
      FORWARDED_ARGS+=("$1")
      ;;
    --vmodel-pair-freeze-active-only)
      VMODEL_PAIR_FREEZE_ACTIVE_ONLY=true
      FORWARDED_ARGS+=("$1")
      ;;
    --help|-h)
      show_usage
      echo ""
      echo "環境と .helix/ の整合性をチェックします。"
      echo "--cleanup-stale-locks を付けると dead PID の lockfile を削除します。"
      echo "check_recovery_plan_freshness は docs/plans/PLAN-*-recovery-*.md を走査し、鮮度警告を表示します。"
      echo "--strict-vmodel-pair-freeze を付けると critical missing pair docs がある場合に exit 1 で失敗します。"
      echo "--vmodel-pair-freeze-active-only を付けると status=draft|in_progress の pair PLAN のみ集計します。"
      echo "--json を付けると text 出力を抑止し、構造化 JSON のみを stdout に出力します。"
      exit 0
      ;;
    *)
      echo "エラー: 不明なオプション: $1" >&2
      show_usage >&2
      exit 2
      ;;
  esac
  shift
done

render_doctor_json() {
  local doctor_output="$1"
  python3 - <<'PY' "$doctor_output"
import json
import re
import sys
from datetime import datetime

text = sys.argv[1]
match = re.search(r"結果:\s+(\d+)\s+pass,\s+(\d+)\s+fail,\s+(\d+)\s+warn", text)
if not match:
    raise SystemExit(1)

pass_count, fail_count, warn_count = (int(value) for value in match.groups())
advisories = []
category = ""
current = None

for line in text.splitlines():
    stripped = line.strip()
    if line.startswith("[") and line.endswith("]"):
        category = line[1:-1]
        current = None
        continue

    advisory_match = re.match(r"^\s*(△|✗|⚠|WARN:)\s*(.+)$", line)
    if advisory_match:
        marker, name = advisory_match.groups()
        current = {
            "category": category or "doctor",
            "name": name.replace("（推奨）", "").strip(),
            "status": "fail" if marker == "✗" else "warning",
            "detail": "",
        }
        advisories.append(current)
        continue

    if current is not None and (line.startswith("    ") or line.startswith("      ")):
        detail = stripped
        if detail:
            current["detail"] = f"{current['detail']} {detail}".strip() if current["detail"] else detail
        continue

    current = None

for advisory in advisories:
    if not advisory["detail"]:
      advisory["detail"] = advisory["name"]

payload = {
    "timestamp": datetime.now().astimezone().isoformat(timespec="seconds"),
    "pass": pass_count,
    "fail": fail_count,
    "warn": warn_count,
    "advisories": advisories,
    "summary": f"{pass_count} pass, {fail_count} fail, {warn_count} warn",
}
print(json.dumps(payload, ensure_ascii=False))
PY
}

if [[ "$JSON_OUTPUT" == true ]]; then
  if [[ -n "$SUBCOMMAND" ]]; then
    echo "エラー: --json はデフォルト doctor 出力でのみ使用できます" >&2
    exit 2
  fi

  tmp_stderr="$(mktemp)"
  set +e
  doctor_output="$("$SELF_PATH" "${FORWARDED_ARGS[@]}" 2>"$tmp_stderr")"
  doctor_rc=$?
  set -e
  doctor_stderr="$(cat "$tmp_stderr")"
  rm -f "$tmp_stderr"

  if [[ $doctor_rc -gt 1 ]]; then
    [[ -n "$doctor_stderr" ]] && printf '%s\n' "$doctor_stderr" >&2
    exit "$doctor_rc"
  fi

  if ! json_output="$(render_doctor_json "$doctor_output")"; then
    [[ -n "$doctor_stderr" ]] && printf '%s\n' "$doctor_stderr" >&2
    echo "エラー: doctor text 出力の JSON 変換に失敗しました" >&2
    exit 1
  fi

  printf '%s\n' "$json_output"
  exit "$doctor_rc"
fi

echo "=== HELIX Doctor ==="
PASS=0
FAIL=0
WARN=0
PACKAGE_MANAGER=""

detect_package_manager() {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    echo "brew"
    return
  fi

  if [[ -r /etc/os-release ]]; then
    local os_id
    os_id="$(grep -E '^ID=' /etc/os-release | head -n1 | cut -d= -f2 | tr -d '"')"
    case "$os_id" in
      debian|ubuntu)
        echo "apt"
        return
        ;;
      arch|manjaro)
        echo "pacman"
        return
        ;;
    esac
  fi

  echo "unknown"
}

can_auto_fix_with_apt() {
  [[ "$PACKAGE_MANAGER" == "apt" ]] || return 1
  command -v sudo >/dev/null 2>&1 || return 1
  sudo -n true >/dev/null 2>&1
}

install_hint_for() {
  local dep="$1"
  local apt_pkg=""
  local pacman_pkg=""
  local brew_pkg=""

  case "$dep" in
    sqlite3)
      apt_pkg="sqlite3"
      pacman_pkg="sqlite"
      brew_pkg="sqlite"
      ;;
    rg)
      apt_pkg="ripgrep"
      pacman_pkg="ripgrep"
      brew_pkg="ripgrep"
      ;;
    *)
      return 0
      ;;
  esac

  case "$PACKAGE_MANAGER" in
    apt)
      printf '%s\n' "      → インストール: sudo apt install $apt_pkg"
      ;;
    pacman)
      printf '%s\n' "      → インストール: sudo pacman -S --needed $pacman_pkg"
      ;;
    brew)
      printf '%s\n' "      → インストール: brew install $brew_pkg"
      ;;
    *)
      printf '%s\n' \
        "      → インストール候補: sudo apt install $apt_pkg      (Debian/Ubuntu)" \
        "                        sudo pacman -S --needed $pacman_pkg  (Arch/Manjaro)" \
        "                        brew install $brew_pkg             (macOS)"
      ;;
  esac
}

check() {
  local name="$1"
  local cmd="$2"
  local fix_cmd="${3:-}"
  if bash -c "$cmd" >/dev/null 2>&1; then
    echo "  ✓ $name"
    PASS=$((PASS + 1))
  else
    if [[ -n "$fix_cmd" && "$FIX" == true ]]; then
      if bash -c "$fix_cmd" >/dev/null 2>&1; then
        echo "  ✓ $name（自動修正）"
        PASS=$((PASS + 1))
        return
      fi
    fi
    echo "  ✗ $name"
    FAIL=$((FAIL + 1))
  fi
}

warn() {
  local name="$1"
  local cmd="$2"
  local hint="${3:-}"
  local fix_cmd="${4:-}"
  if bash -c "$cmd" >/dev/null 2>&1; then
    echo "  ✓ $name"
    PASS=$((PASS + 1))
  else
    if [[ -n "$fix_cmd" && "$FIX" == true ]]; then
      if bash -c "$fix_cmd" >/dev/null 2>&1; then
        echo "  ✓ $name（自動修正）"
        PASS=$((PASS + 1))
        return
      fi
    fi
    echo "  △ $name（推奨）"
    if [[ -n "$hint" ]]; then
      while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        echo "$line"
      done <<< "$hint"
    fi
    WARN=$((WARN + 1))
  fi
}

extract_template_version() {
  local file="$1"
  local version=""
  if [[ -f "$file" ]]; then
    version="$(grep -E -m1 'helix_template_version:[[:space:]]*[0-9]+' "$file" | sed -E 's/.*helix_template_version:[[:space:]]*([0-9]+).*/\1/' || true)"
  fi
  if [[ -n "$version" ]]; then
    echo "$version"
  else
    echo "0"
  fi
}

check_template_version() {
  local project_file="$1"
  local template_file="$2"
  local label="$3"
  local project_version template_version
  project_version="$(extract_template_version "$project_file")"
  template_version="$(extract_template_version "$template_file")"

  if [[ "$project_version" == "$template_version" ]]; then
    echo "  ✓ $label テンプレート版数 (v$project_version)"
    PASS=$((PASS + 1))
  else
    echo "  WARN: $label (v$project_version) が古い → テンプレート (v$template_version)。helix init --force で更新可"
    WARN=$((WARN + 1))
  fi
}

get_conf_value() {
  local conf_path="$1"
  local key="$2"
  local value
  value="$(sed -n "s/^${key}=//p" "$conf_path" | head -n1)"
  value="${value%\"}"
  value="${value#\"}"
  value="${value%\'}"
  value="${value#\'}"
  printf '%s' "$value"
}

get_agent_frontmatter_value() {
  local agent_path="$1"
  local key="$2"

  python3 - "$agent_path" "$key" <<'PY'
from __future__ import annotations

import sys
from pathlib import Path

agent_path = Path(sys.argv[1])
key = sys.argv[2]

if not agent_path.is_file():
    raise SystemExit(0)

raw = agent_path.read_text(encoding="utf-8")
lines = raw.splitlines()
if not lines or lines[0].strip() != "---":
    raise SystemExit(0)

end = None
for idx, line in enumerate(lines[1:], start=1):
    if line.strip() == "---":
        end = idx
        break

if end is None:
    raise SystemExit(0)

prefix = f"{key}:"
for line in lines[1:end]:
    stripped = line.strip()
    if not stripped.startswith(prefix):
        continue
    value = stripped[len(prefix):].strip()
    if value[:1] in {"'", '"'} and value[-1:] == value[:1]:
        value = value[1:-1]
    print(value)
    raise SystemExit(0)
PY
}

check_role_config_consistency() {
  local roles_file="${HELIX_HOME}/cli/config/models.yaml"
  local roles_dir="${HELIX_HOME}/cli/roles"
  local agents_dir="${HELIX_HOME}/.claude/agents"
  local runtime_yaml_parser
  local codex_mismatch=0
  local pmo_mismatch=0
  local conf_path
  local role
  local conf_value
  local yaml_value

  runtime_yaml_parser="$(cd "$(dirname "$0")" && pwd)/lib/yaml_parser.py"

  check_pmo_mirror() {
    local conf_path="$1"
    local conf_key="$2"
    local yaml_key="$3"
    local label="$4"
    local conf_value
    local yaml_value

    conf_value="$(get_conf_value "$conf_path" "$conf_key")"
    yaml_value="$(python3 "$runtime_yaml_parser" read "$roles_file" "$yaml_key" 2>/dev/null || true)"
    if [[ "$conf_value" != "$yaml_value" ]]; then
      echo "WARNING: pmo role $(basename "$conf_path" .conf): ${label} conf=${conf_value:-missing}, yaml=${yaml_value:-missing} (mismatch)"
      pmo_mismatch=$((pmo_mismatch + 1))
    fi
  }

  check_pmo_agent_mirror() {
    local role="$1"
    local agent_key="$2"
    local yaml_key="$3"
    local label="$4"
    local agent_path="$agents_dir/$role.md"
    local agent_value
    local yaml_value

    if [[ ! -f "$agent_path" ]]; then
      echo "WARNING: pmo role $role: agent file ${agent_path#$HELIX_HOME/} missing"
      pmo_mismatch=$((pmo_mismatch + 1))
      return
    fi

    agent_value="$(get_agent_frontmatter_value "$agent_path" "$agent_key" 2>/dev/null || true)"
    yaml_value="$(python3 "$runtime_yaml_parser" read "$roles_file" "$yaml_key" 2>/dev/null || true)"
    if [[ "$agent_value" != "$yaml_value" ]]; then
      echo "WARNING: pmo role $role: agent $label frontmatter=${agent_value:-missing}, yaml=${yaml_value:-missing} (mismatch)"
      pmo_mismatch=$((pmo_mismatch + 1))
    fi
  }

  if [[ ! -f "$roles_file" || ! -d "$roles_dir" ]]; then
    echo "  ✗ role config consistency (required files missing)"
    FAIL=$((FAIL + 1))
    return
  fi

  for conf_path in "$roles_dir"/*.conf; do
    role="$(basename "$conf_path" .conf)"

    if [[ "$role" == pmo-* ]]; then
      conf_value="$(get_conf_value "$conf_path" "claude_model")"
      yaml_value="$(python3 "$runtime_yaml_parser" read "$roles_file" "roles.$role" 2>/dev/null || true)"
      if [[ "$conf_value" != "$yaml_value" ]]; then
        echo "WARNING: pmo role $role: claude_model conf=${conf_value:-missing}, yaml=${yaml_value:-missing} (mismatch)"
        pmo_mismatch=$((pmo_mismatch + 1))
      fi

      conf_value="$(get_conf_value "$conf_path" "claude_thinking")"
      yaml_value="$(python3 "$runtime_yaml_parser" read "$roles_file" "role_metadata.$role.thinking" 2>/dev/null || true)"
      if [[ "$conf_value" != "$yaml_value" ]]; then
        echo "WARNING: pmo role $role: claude_thinking conf=${conf_value:-missing}, yaml=${yaml_value:-missing} (mismatch)"
        pmo_mismatch=$((pmo_mismatch + 1))
      fi

      conf_value="$(get_conf_value "$conf_path" "claude_permission_mode")"
      yaml_value="$(python3 "$runtime_yaml_parser" read "$roles_file" "role_metadata.$role.permission_mode" 2>/dev/null || true)"
      if [[ -n "$conf_value" && "$conf_value" != "$yaml_value" ]]; then
        echo "WARNING: pmo role $role: claude_permission_mode conf=${conf_value:-missing}, yaml=${yaml_value:-missing} (mismatch)"
        pmo_mismatch=$((pmo_mismatch + 1))
      fi

      conf_value="$(get_conf_value "$conf_path" "claude_disallowed_tools")"
      yaml_value="$(python3 "$runtime_yaml_parser" read "$roles_file" "role_metadata.$role.disallowed_tools" 2>/dev/null || true)"
      if [[ -n "$conf_value" && "$conf_value" != "$yaml_value" ]]; then
        echo "WARNING: pmo role $role: claude_disallowed_tools conf=${conf_value:-missing}, yaml=${yaml_value:-missing} (mismatch)"
        pmo_mismatch=$((pmo_mismatch + 1))
      fi

      if [[ "$(get_conf_value "$conf_path" "codex_thinking")" != "" || "$(python3 "$runtime_yaml_parser" read "$roles_file" "role_metadata.$role.codex_thinking" 2>/dev/null || true)" != "" ]]; then
        check_pmo_mirror "$conf_path" "codex_thinking" "role_metadata.$role.codex_thinking" "codex_thinking"
      fi
      if [[ "$(get_conf_value "$conf_path" "codex_permission_mode")" != "" ]]; then
        check_pmo_mirror "$conf_path" "codex_permission_mode" "role_metadata.$role.codex_permission_mode" "codex_permission_mode"
      fi
      if [[ "$(get_conf_value "$conf_path" "codex_disallowed_tools")" != "" ]]; then
        check_pmo_mirror "$conf_path" "codex_disallowed_tools" "role_metadata.$role.codex_disallowed_tools" "codex_disallowed_tools"
      fi

      if [[ "$role" == "pmo-haiku" ]]; then
        conf_value="$(get_conf_value "$conf_path" "claude_allow_paths")"
        yaml_value="$(python3 "$runtime_yaml_parser" read "$roles_file" "role_metadata.$role.allow_paths" 2>/dev/null || true)"
        if [[ -n "$conf_value" && "$conf_value" != "$yaml_value" ]]; then
          echo "WARNING: pmo role $role: claude_allow_paths conf=${conf_value:-missing}, yaml=${yaml_value:-missing} (mismatch)"
          pmo_mismatch=$((pmo_mismatch + 1))
        fi

        if [[ "$(get_conf_value "$conf_path" "codex_allow_paths")" != "" ]]; then
          check_pmo_mirror "$conf_path" "codex_allow_paths" "role_metadata.$role.codex_allow_paths" "codex_allow_paths"
        fi
      fi

      check_pmo_agent_mirror "$role" "model" "roles.$role" "model"
      check_pmo_agent_mirror "$role" "effort" "role_metadata.$role.thinking" "effort"

      continue
    fi

    conf_value="$(get_conf_value "$conf_path" "codex_model")"
    yaml_value="$(python3 "$runtime_yaml_parser" read "$roles_file" "roles.$role" 2>/dev/null || true)"

    if [[ -z "$conf_value" || -z "$yaml_value" ]]; then
      echo "WARNING: role $role: conf=${conf_value:-missing}, yaml=${yaml_value:-missing} (mismatch)"
      codex_mismatch=$((codex_mismatch + 1))
      continue
    fi

    if [[ "$conf_value" != "$yaml_value" ]]; then
      echo "WARNING: role $role: conf=$conf_value, yaml=$yaml_value (mismatch)"
      codex_mismatch=$((codex_mismatch + 1))
    fi
  done

  if [[ $codex_mismatch -eq 0 ]]; then
    echo "  ✓ role config consistency"
    PASS=$((PASS + 1))
  else
    echo "  △ role config consistency"
    WARN=$((WARN + 1))
  fi

  if [[ $pmo_mismatch -eq 0 ]]; then
    echo "  ✓ pmo role consistency"
    PASS=$((PASS + 1))
  else
    echo "  △ pmo role consistency"
    WARN=$((WARN + 1))
  fi
}

check_role_effort_consistency() {
  local roles_dir="$PROJECT_ROOT/cli/roles"
  local effort_drift_count=0
  local role_confs=()
  local role_conf
  local role_name
  local conf_effort

  shopt -s nullglob
  role_confs=("$roles_dir"/*.conf)
  shopt -u nullglob

  for role_conf in "${role_confs[@]}"; do
    role_name="$(basename "$role_conf" .conf)"
    conf_effort="$(grep '^codex_thinking=' "$role_conf" 2>/dev/null | cut -d= -f2 || true)"
    if [[ -n "$conf_effort" ]]; then
      if grep -qE "${role_name}.*${conf_effort}|${conf_effort}.*${role_name}" \
        "$PROJECT_ROOT/skills/SKILL_MAP.md" \
        "$PROJECT_ROOT/cli/ROLE_MAP.md" 2>/dev/null; then
        :
      else
        effort_drift_count=$((effort_drift_count + 1))
      fi
    fi
  done

  if [[ $effort_drift_count -gt 0 ]]; then
    echo "    △ role effort drift: $effort_drift_count 件"
    echo "      role conf vs CLAUDE.md / SKILL_MAP / ROLE_MAP の effort 表記乖離あり"
    WARN=$((WARN + 1))
  else
    echo "    ✓ role effort 整合性"
    PASS=$((PASS + 1))
  fi
}

check_mode_phase_consistency() {
  local phase_yaml="$PROJECT_ROOT/.helix/phase.yaml"
  if [[ ! -f "$phase_yaml" ]]; then
    return 0
  fi

  local current_mode current_phase
  current_mode=$(grep -E '^current_mode:' "$phase_yaml" | sed 's/^current_mode: *//' | tr -d "\"'" | tr -d ' ')
  current_phase=$(grep -E '^current_phase:' "$phase_yaml" | sed 's/^current_phase: *//' | tr -d "\"'" | tr -d ' ')
  if [[ -z "$current_mode" || -z "$current_phase" ]]; then
    return 0
  fi

  if [[ "$current_mode" == "scrum" ]]; then
    current_mode="discovery"
  fi

  case "$current_mode" in
    forward)
      if ! [[ "$current_phase" =~ ^L([1-9]|1[01])$ ]]; then
        echo "  ⚠ phase_mode_consistency: mode=forward だが phase=$current_phase (L1-L11 期待)"
        WARN=$((WARN + 1))
      else
        echo "  ✓ phase_mode_consistency: forward + $current_phase"
      fi
      ;;
    reverse)
      if ! [[ "$current_phase" =~ ^(R[0-4]|RGC)$ ]]; then
        echo "  ⚠ phase_mode_consistency: mode=reverse だが phase=$current_phase (R0-R4/RGC 期待)"
        WARN=$((WARN + 1))
      else
        echo "  ✓ phase_mode_consistency: reverse + $current_phase"
      fi
      ;;
    discovery)
      if ! [[ "$current_phase" =~ ^(D[0-4]|S[0-4])$ ]]; then
        echo "  ⚠ phase_mode_consistency: mode=discovery だが phase=$current_phase (D0-D4/S0-S4 期待)"
        WARN=$((WARN + 1))
      else
        echo "  ✓ phase_mode_consistency: discovery + $current_phase"
      fi
      ;;
    *)
      echo "  ⚠ phase_mode_consistency: 未知 mode=$current_mode"
      WARN=$((WARN + 1))
      ;;
  esac
}

check_discovery_compat_warnings() {
  local phase_yaml="$PROJECT_ROOT/.helix/phase.yaml"
  [[ -f "$phase_yaml" ]] || return 0

  local current_mode sprint_drive
  current_mode=$(grep -E '^current_mode:' "$phase_yaml" | sed 's/^current_mode: *//' | tr -d "\"'" | tr -d ' ')
  sprint_drive=$(python3 "$YAML_PARSER" read "$phase_yaml" sprint.drive 2>/dev/null || echo "")

  if [[ "$current_mode" == "scrum" || "$sprint_drive" == "scrum" ]]; then
    echo "  △ discovery_compat: scrum legacy 値を検出しました。discovery へ移行してください。"
    WARN=$((WARN + 1))
  else
    echo "  ✓ discovery_compat: discovery mode/drive"
    PASS=$((PASS + 1))
  fi
}

extract_declared_count() {
  local file="$1"
  local pattern="$2"
  python3 - <<'PY' "$file" "$pattern"
import re
import sys
from pathlib import Path

text = Path(sys.argv[1]).read_text(encoding="utf-8")
match = re.search(sys.argv[2], text)
if not match:
    raise SystemExit(1)
print(match.group(1))
PY
}

check_drift_count() {
  local name="$1"
  local measured="$2"
  local declared="$3"
  if [[ -n "$declared" && "$measured" == "$declared" ]]; then
    echo "  ✓ $name"
    PASS=$((PASS + 1))
    return
  fi

  echo "  △ $name"
  echo "    実測 ${measured:-unknown} / 文書記述 ${declared:-unknown}、SKILL_MAP.md / ROLE_MAP.md を更新してください"
  WARN=$((WARN + 1))
}

check_document_drift() {
  local skill_map="$PROJECT_ROOT/skills/SKILL_MAP.md"
  local role_map="$PROJECT_ROOT/cli/ROLE_MAP.md"
  local skills_count agents_count roles_count
  local declared_skills="" declared_agents="" declared_roles=""

  if [[ -d "$PROJECT_ROOT/skills" ]]; then
    skills_count="$(find "$PROJECT_ROOT/skills" -name SKILL.md | wc -l | tr -d '[:space:]')"
  else
    skills_count="0"
  fi

  if [[ -d "$PROJECT_ROOT/.claude/agents" ]]; then
    agents_count="$(find "$PROJECT_ROOT/.claude/agents" -maxdepth 1 -type f -name '*.md' | wc -l | tr -d '[:space:]')"
  else
