  if [[ "$current_mode" == "scrum" ]]; then
    current_mode="discovery"
  fi

  case "$current_mode" in
    forward)
      if ! [[ "$current_phase" =~ ^L([0-9]|1[0-4])$ ]]; then
        echo "  ⚠ phase_mode_consistency: mode=forward だが phase=$current_phase (L0-L14 期待)"
