check_phase_gate_progress_consistency() {
  local phase_yaml="$PROJECT_ROOT/.helix/phase.yaml"
  if [[ ! -f "$phase_yaml" ]]; then
    return 0
  fi

  local current_phase
  current_phase=$(grep -E '^current_phase:' "$phase_yaml" | sed 's/^current_phase: *//' | tr -d "\"'" | tr -d ' ')
  if [[ -z "$current_phase" || ! "$current_phase" =~ ^L([0-9]|1[0-4])$ ]]; then
    return 0
  fi

  local gate gate_status highest_gate="" highest_layer=0 layer current_layer
  for gate in G1 G2 G3 G4 G5 G6; do
    gate_status=$(python3 "$YAML_PARSER" read "$phase_yaml" "gates.${gate}.status" 2>/dev/null || true)
    if [[ "$gate_status" == "passed" ]]; then
      layer="${gate#G}"
      if (( layer > highest_layer )); then
        highest_layer="$layer"
        highest_gate="$gate"
      fi
    fi
  done

  if [[ -z "$highest_gate" ]]; then
    echo "  ✓ phase_gate_progress: L1-L6 gate progress evidence not yet recorded"
    return 0
  fi

  current_layer="${current_phase#L}"
  if (( current_layer < highest_layer )); then
    echo "  ⚠ phase_gate_progress: ${highest_gate} passed だが current_phase=${current_phase} (少なくとも L${highest_layer} 表示が期待)"
    WARN=$((WARN + 1))
    return 0
  fi

  echo "  ✓ phase_gate_progress: ${highest_gate} passed + current_phase=${current_phase}"
}

