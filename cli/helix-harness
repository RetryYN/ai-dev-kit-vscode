#!/usr/bin/env bash
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

usage() {
  cat <<'EOF'
使い方: helix harness <subcommand> [options]

Subcommands:
  recommend-compact   現セッション msg count から /compact 推奨可否を判定
  auto-dump           handover/CURRENT.json を機械抽出値で update
  status              active slot と警告イベントの現状を表示
  feedback-loop       DB 入力から route / learning candidate を表示

Options:
  --json              JSON 出力
  --threshold <float> compact 推奨 threshold (default: 0.6666, context_guard SSoT 由来)
  --days <int>        feedback-loop / status の参照 window (default: 7)
  --limit <int>       feedback-loop の最大候補数 (default: 20)
EOF
}

cd "$REPO_ROOT" || exit 2

case "${1:-}" in
  recommend-compact)
    shift
    exec python3 -m cli.lib.handover_auto_dump recommend-compact "$@"
    ;;
  auto-dump)
    shift
    exec python3 -m cli.lib.handover_auto_dump auto-dump "$@"
    ;;
  status)
    shift
    exec python3 -c "$(cat <<'PY'
import json
import sys
from datetime import UTC, datetime

from cli.lib import agent_slots, harness_monitor

json_mode = "--json" in sys.argv[1:]
status = harness_monitor.get_active_status()
slots = agent_slots.list_active_slots()
events = sorted(
    status.get("recent_criticals", []) + status.get("recent_warnings", []),
    key=lambda item: ((item.get("triggered_at") or ""), int(item.get("id") or 0)),
    reverse=True,
)[:5]
peak_parallel = int(status.get("peak_parallel_today") or 0)

try:
    harness_monitor.record_event(
        "pull",
        "status_viewed",
        payload={"json": json_mode, "active_slot_count": len(slots)},
    )
except Exception:
    pass

if json_mode:
    print(json.dumps(status, ensure_ascii=False, indent=2))
    raise SystemExit(0)

def duration_text(started_at: str | None) -> str:
    if not started_at:
        return "-"
    try:
        started = datetime.strptime(started_at, "%Y-%m-%d %H:%M:%S").replace(tzinfo=UTC)
    except ValueError:
        return "?"
    elapsed = max(0, int((datetime.now(UTC) - started).total_seconds()))
    minutes, seconds = divmod(elapsed, 60)
    hours, minutes = divmod(minutes, 60)
    if hours:
        return f"{hours}h{minutes:02d}m"
    if minutes:
        return f"{minutes}m{seconds:02d}s"
    return f"{seconds}s"

print("[Active Slots]")
if slots:
    print("invocation_id agent_kind      role       status     duration plan/wbs")
    for slot in slots:
        scope = slot.get("plan_id") or "-"
        if slot.get("task_id"):
            scope = f"{scope}/{slot['task_id']}"
        elif slot.get("sprint"):
            scope = f"{scope}/{slot['sprint']}"
        print(
            f"{str(slot.get('id', '-')):<13} "
            f"{str(slot.get('agent_kind') or '-'): <15}"
            f"{str(slot.get('role') or '-'): <11}"
            f"{str(slot.get('status') or '-'): <10}"
            f"{duration_text(slot.get('fired_at')):<9} "
            f"{scope}"
        )
else:
    print("(none)")

print("\n[Recent Warnings]")
if events:
    for event in events:
        payload = event.get("payload") or {}
        detail = payload.get("active") if isinstance(payload, dict) else None
        suffix = f" active={detail}" if detail is not None else ""
        print(
            f"{event.get('triggered_at', '-')} "
            f"{event.get('severity', '-'):>8} "
            f"{event.get('check_name', '-')}{suffix}"
        )
else:
    print("(none)")

print(f"\n[Peak Parallel Today]: {peak_parallel}")
print(f"[8 並列遵守率]: {len(slots)}/8")
PY
)" "$@"
    ;;
  feedback-loop)
    shift
    exec python3 -c "$(cat <<'PY'
import contextlib
import io
import json
import sys

from cli.lib import harness_monitor

json_mode = False
days = 7
limit = 20
args = sys.argv[1:]
idx = 0
while idx < len(args):
    arg = args[idx]
    if arg == "--json":
        json_mode = True
        idx += 1
        continue
    if arg == "--days" and idx + 1 < len(args):
        days = int(args[idx + 1])
        idx += 2
        continue
    if arg == "--limit" and idx + 1 < len(args):
        limit = int(args[idx + 1])
        idx += 2
        continue
    raise SystemExit(f"未知のオプション: {arg}")

snapshot = harness_monitor.get_feedback_loop_snapshot(days=days, limit=limit)
with contextlib.redirect_stderr(io.StringIO()):
    try:
        harness_monitor.record_feedback_loop_missing_feedback(snapshot)
        harness_monitor.record_feedback_loop_observability(snapshot)
    except Exception:
        pass

if json_mode:
    print(json.dumps(snapshot, ensure_ascii=False, indent=2))
    raise SystemExit(0)

with contextlib.redirect_stderr(io.StringIO()):
    try:
        harness_monitor.record_event(
            "pull",
            "feedback_loop_viewed",
            payload={
                "days": days,
                "route_candidates": len(snapshot.get("route_candidates", [])),
                "learning_candidates": len(snapshot.get("learning_candidates", [])),
            },
        )
    except Exception:
        pass

counts = snapshot.get("counts", {})
print("[Feedback Loop]")
print(
    "counts "
    + " ".join(f"{key}={value}" for key, value in sorted(counts.items()))
)
print("\n[Route Candidates]")
route_candidates = snapshot.get("route_candidates", [])
if route_candidates:
    for item in route_candidates:
        route = item.get("route") or {}
        evidence = item.get("evidence") or {}
        print(
            f"{item.get('signal')} -> {route.get('mode')} "
            f"{route.get('priority')} source={evidence.get('source')} id={evidence.get('id')}"
        )
else:
    print("(none)")

print("\n[Learning Candidates]")
learning_candidates = snapshot.get("learning_candidates", [])
if learning_candidates:
    for item in learning_candidates:
        print(f"{item.get('kind')} source={item.get('source')}: {item.get('summary')}")
else:
    print("(none)")

print("\n[PLAN Draft Candidates]")
plan_candidates = snapshot.get("plan_candidates", [])
if plan_candidates:
    for item in plan_candidates:
        print(f"{item.get('title')} key={item.get('source_pattern_key')}")
else:
    print("(none)")

print("\n[PR Candidates]")
pr_candidates = snapshot.get("pr_candidates", [])
if pr_candidates:
    for item in pr_candidates:
        print(f"{item.get('title')} key={item.get('source_pattern_key')}")
else:
    print("(none)")
PY
)" "$@"
    ;;
  -h|--help|"")
    usage
    ;;
  *)
    echo "未知のサブコマンド: $1" >&2
    usage >&2
    exit 2
    ;;
esac
